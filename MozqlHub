-- ── Aimlock ───────────────────────────────
Tab.Combat:Section({ Title="Aimlock" })

local AimlockEnabled = false
local AimlockConn = nil

local function GetClosestToCenter()
    local mid = Camera.ViewportSize / 2
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local sp, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - mid).Magnitude
                    if d < bestDist then best = root bestDist = d end
                end
            end
        end
    end
    return best
end

Tab.Combat:Toggle({
    Title    = "Aimlock (Murderer Priority)",
    Value    = false,
    Callback = function(s)
        AimlockEnabled = s
        if AimlockConn then AimlockConn:Disconnect() end
        if not s then return end
        AimlockConn = RunService.RenderStepped:Connect(function()
            if not AimlockEnabled then return end
            -- prioritise murderer
            local murd = FindMurderer()
            local target = murd and murd.Character and murd.Character:FindFirstChild("HumanoidRootPart")
            if not target then target = GetClosestToCenter() end
            if target then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            end
        end)
    end,
})

