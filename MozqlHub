-- ── Hitbox ────────────────────────────────
Tab.Combat:Section({ Title="Hitbox" })

local HitboxEnabled = false
local HitboxSize    = 5
local HitboxColor   = Color3.new(1, 0, 0.6)
local HitboxAdorn   = {}
local HitboxConn    = nil

local function UpdateHitboxes()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local ador = HitboxAdorn[p]
            if root and HitboxEnabled then
                if ador then
                    ador.Size   = Vector3.one * HitboxSize
                    ador.Color3 = HitboxColor
                else
                    local a = Instance.new("BoxHandleAdornment")
                    a.Adornee      = root
                    a.Size         = Vector3.one * HitboxSize
                    a.Color3       = HitboxColor
                    a.Transparency = 0.45
                    a.ZIndex       = 10
                    a.Parent       = root
                    HitboxAdorn[p] = a
                end
            elseif ador then
                ador:Destroy()
                HitboxAdorn[p] = nil
            end
        end
    end
end

Tab.Combat:Toggle({
    Title    = "Hitbox Expander",
    Value    = false,
    Callback = function(s)
        HitboxEnabled = s
        if s then
            if not HitboxConn then
                HitboxConn = RunService.Heartbeat:Connect(UpdateHitboxes)
            end
        else
            if HitboxConn then HitboxConn:Disconnect() HitboxConn = nil end
            for _, a in pairs(HitboxAdorn) do if a then a:Destroy() end end
            HitboxAdorn = {}
        end
    end,
})

