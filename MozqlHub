-- ── Silent Gun Aim ──────────────────────────
Tab.Combat:Section({ Title="Gun" })

local GunSilentEnabled = false
local GunSilentConn = nil
local _G_GunArgs = nil

local function FireGun()
    if not _G_GunArgs then return end
    local gun = GetChar() and GetChar():FindFirstChild("Gun")
    local remote = gun and gun:FindFirstChild("Shoot")
    if remote then remote:FireServer(table.unpack(_G_GunArgs)) end
end

Tab.Combat:Toggle({
    Title    = "Gun Silent Aim",
    Value    = false,
    Callback = function(s)
        GunSilentEnabled = s
        if GunSilentConn then GunSilentConn:Disconnect() end
        if not s then _G_GunArgs = nil return end
        GunSilentConn = RunService.RenderStepped:Connect(function()
            local target = FindMurderer()
            if not (target and target.Character) then _G_GunArgs = nil return end
            local tr = target.Character:FindFirstChild("HumanoidRootPart")
            local mr = GetRoot()
            if not (tr and mr) then return end
            local pred = tr.CFrame + (tr.Velocity * 0.125)
            _G_GunArgs = { mr.CFrame, pred }
        end)
    end,
})

