Tab.Farm:Section({ Title="Coin Farm" })

local CoinFarmEnabled    = false
local CoinFarmMode       = "Nearest"
local TeleportInterval   = 4
local LastTeleportTime   = 0
local LastTeleportedCoin = nil
local CoinContainer      = nil

local function FindCoin(root)
    local cc = CoinContainer
    if not cc then return end
    local best, bestDist = nil, math.huge
    local all = {}
    for _, child in ipairs(cc:GetChildren()) do
        local part = child:IsA("BasePart") and child or (child:IsA("Model") and child.PrimaryPart)
        if part and part.Parent and part ~= LastTeleportedCoin then
            if CoinFarmMode == "Nearest" then
                local d = (root.Position - part.Position).Magnitude
                if d < bestDist then best = part bestDist = d end
            else
                table.insert(all, part)
            end
        end
    end
    if CoinFarmMode == "Nearest" then return best end
    if #all > 0 then return all[math.random(1, #all)] end
end

RunService.Heartbeat:Connect(function()
    if not (CoinContainer and CoinContainer.Parent) then
        CoinContainer = Workspace:FindFirstChild("CoinContainer", true)
    end
    if not CoinFarmEnabled or not CoinContainer then return end
    local root = GetRoot()
    local hum  = GetHum()
    if not (root and hum and hum.Health > 0) then return end
    local now = os.clock()
    if now - LastTeleportTime < TeleportInterval then return end
    local coin = FindCoin(root)
    if coin then
        root.CFrame = coin.CFrame
        LastTeleportedCoin = coin
        LastTeleportTime = now
    end
end)

