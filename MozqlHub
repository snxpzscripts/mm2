Tab.Misc:Section({ Title="Invisibility" })

local InvisEnabled = false
local InvisAnimId  = "90878454666108"
local InvisAnim    = nil
local InvisAnimConn= nil
local InvisHBConn  = nil

local function SetTransparency(char, t)
    if not char then return end
    local parts = {"Head","UpperTorso","LowerTorso","LeftUpperArm","LeftLowerArm","LeftHand",
                   "RightUpperArm","RightLowerArm","RightHand","LeftUpperLeg","LeftLowerLeg",
                   "LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot"}
    for _, name in ipairs(parts) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then p.Transparency = t end
    end
end

local function EnableInvis(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid")
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    SetTransparency(char, 0.5)
    InvisAnimConn = hum.AnimationPlayed:Connect(function(t)
        if not t.Animation.AnimationId:find(InvisAnimId) then t:Stop() end
    end)
    InvisHBConn = RunService.Heartbeat:Connect(function()
        if InvisEnabled and not (InvisAnim and InvisAnim.IsPlaying) then
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://"..InvisAnimId
            InvisAnim = animator:LoadAnimation(a)
            InvisAnim:Play()
            InvisAnim.TimePosition = 0.2
            InvisAnim:AdjustSpeed(0)
        end
    end)
end

local function DisableInvis(char)
    if InvisAnimConn then InvisAnimConn:Disconnect() InvisAnimConn=nil end
    if InvisHBConn   then InvisHBConn:Disconnect()   InvisHBConn=nil  end
    if InvisAnim     then InvisAnim:Stop()            InvisAnim=nil    end
    SetTransparency(char, 0)
end

