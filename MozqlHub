local TouchFlingOn = false
Tab.Players:Toggle({
    Title    = "Touch Fling",
    Value    = false,
    Callback = function(s)
        TouchFlingOn = s
        if s then
            coroutine.wrap(function()
                local tv = 0.1
                while TouchFlingOn do
                    RunService.Heartbeat:Wait()
                    local root = GetRoot()
                    if root then
                        local cv = root.Velocity
                        root.Velocity = cv * 10000 + Vector3.new(0, 10000, 0)
                        RunService.RenderStepped:Wait()
                        if root and root.Parent then root.Velocity = cv end
                        RunService.Stepped:Wait()
                        if root and root.Parent then
                            root.Velocity = cv + Vector3.new(0, tv, 0)
                            tv = tv * -1
                        end
                    end
                end
            end)()
        end
    end,
})

local AntiFlingConns = {}
local AntiFlingOn = false

Tab.Players:Toggle({
    Title    = "Anti-Fling",
    Value    = false,
    Callback = function(s)
        AntiFlingOn = s
        for _, c in pairs(AntiFlingConns) do c:Disconnect() end
        table.clear(AntiFlingConns)
        if s then
            local function setupNcForPlayer(p)
                if p == LocalPlayer then return end
                local c = RunService.Stepped:Connect(function()
                    if AntiFlingOn and p.Character then
                        for _, part in pairs(p.Character:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                    end
                end)
                table.insert(AntiFlingConns, c)
            end
            for _, p in pairs(Players:GetPlayers()) do setupNcForPlayer(p) end
            Players.PlayerAdded:Connect(setupNcForPlayer)
        else
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character then
                    for _, part in pairs(p.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = true end
                    end
                end
            end
        end
    end,
})

