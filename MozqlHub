Tab.Visual:Section({ Title="ESP" })

do -- register-safe block
    local Cfg = {
        Master     = false,
        Highlight  = true,
        Labels     = true,
        Lines      = false,
        Murderer   = true,
        Sheriff    = true,
        Innocent   = true,
        Guns       = true,
        ChamsAlpha = 0.5,
    }

    local Colors = {
        Murder     = Color3.fromRGB(255, 50,  150),
        Sheriff    = Color3.fromRGB(80,  160, 255),
        Innocent   = Color3.fromRGB(100, 255, 180),
        DroppedGun = Color3.fromRGB(255, 230, 60),
    }

    local PlayerESP = {}
    local GunESP    = {}
    local RoleCache = {}
    local GunCache  = {}

    local Pool = {Box={}, Text={}, Line={}}

    local function Acquire(kind)
        if #Pool[kind] > 0 then
            local d = table.remove(Pool[kind])
            d.Visible = false
            return d
        end
        local map = {Box="Square", Text="Text", Line="Line"}
        return Drawing.new(map[kind])
    end

    local function Release(kind, d)
        if not d then return end
        d.Visible = false
        table.insert(Pool[kind], d)
    end

    local function RemoveHL(entry)
        if entry and entry.HL then
            pcall(function() entry.HL:Destroy() end)
            entry.HL = nil
        end
    end

    local function DestroyEntry(entry)
        if not entry then return end
        Release("Box",  entry.Box)
        Release("Text", entry.Text)
        Release("Line", entry.Line)
        RemoveHL(entry)
    end

    local function NewEntry()
        local box = Acquire("Box")
        box.Thickness = 1.6
        box.Filled = false
        box.Transparency = 1

        local text = Acquire("Text")
        text.Size = 17
        text.Center = true
        text.Outline = true
        text.Font = 2

        local line = Acquire("Line")
        line.Thickness = 1.5
        line.Transparency = 0.8

        return { Box=box, Text=text, Line=line, HL=nil }
    end

    local function GetRole(p)
        local function scan(loc)
            if not loc then return nil end
            for _, item in ipairs(loc:GetChildren()) do
                if item:IsA("Tool") then
                    local n = item.Name:lower()
                    if n:find("knife") then return "Murder" end
                    if n:find("gun") or n:find("revolver") then return "Sheriff" end
                end
            end
        end
        return scan(p.Character) or scan(p:FindFirstChild("Backpack")) or "Innocent"
    end

    local function EnsureHL(entry, adornee, color)
        if entry.HL then
            entry.HL.FillTransparency = Cfg.ChamsAlpha
            return
        end
        local h = Instance.new("Highlight")
        h.FillColor          = color
        h.OutlineColor       = color
        h.FillTransparency   = Cfg.ChamsAlpha
        h.OutlineTransparency= 0.15
        h.DepthMode          = Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee            = adornee
        h.Parent             = adornee
        entry.HL = h
    end

    local function CleanAll()
        for _, e in pairs(PlayerESP) do DestroyEntry(e) end
        for _, e in pairs(GunESP)    do DestroyEntry(e) end
        table.clear(PlayerESP)
        table.clear(GunESP)
        table.clear(RoleCache)
    end

    -- gun tracking
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v.Name == "GunDrop" and v:IsA("BasePart") then GunCache[v] = true end
    end
    Workspace.DescendantAdded:Connect(function(d)
        if d.Name == "GunDrop" and d:IsA("BasePart") then GunCache[d] = true end
    end)
    Workspace.DescendantRemoving:Connect(function(d)
        if d.Name == "GunDrop" and d:IsA("BasePart") then
            GunCache[d] = nil
            if GunESP[d] then DestroyEntry(GunESP[d]) GunESP[d] = nil end
        end
    end)

    Players.PlayerRemoving:Connect(function(p)
        if PlayerESP[p] then DestroyEntry(PlayerESP[p]) PlayerESP[p] = nil end
        RoleCache[p] = nil
    end)

    local function ESPUpdate()
        if not Cfg.Master then return end
        local mid = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local char = p.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local alive= hum and hum.Health > 0

            if not (char and root and alive) then
                if PlayerESP[p] then DestroyEntry(PlayerESP[p]) PlayerESP[p] = nil RoleCache[p] = nil end
                continue
            end

            local role = GetRole(p)
            local show = (role=="Murder" and Cfg.Murderer) or (role=="Sheriff" and Cfg.Sheriff) or (role=="Innocent" and Cfg.Innocent)

            if not show then
                if PlayerESP[p] then DestroyEntry(PlayerESP[p]) PlayerESP[p] = nil end
                continue
            end

            if not PlayerESP[p] then PlayerESP[p] = NewEntry() end
            local entry = PlayerESP[p]
            local sp, onScreen = Camera:WorldToViewportPoint(root.Position)
            local c = Colors[role]

            if onScreen then
                if Cfg.Highlight then
                    EnsureHL(entry, char, c)
                else
                    RemoveHL(entry)
                end

                entry.Box.Visible  = true
                entry.Box.Color    = c
                entry.Box.Position = Vector2.new(sp.X-22, sp.Y-32)
                entry.Box.Size     = Vector2.new(44, 64)

                entry.Text.Visible  = Cfg.Labels
                entry.Text.Text     = "["..role:upper().."] "..p.Name
                entry.Text.Color    = c
                entry.Text.Position = Vector2.new(sp.X, sp.Y - 52)

                entry.Line.Visible  = Cfg.Lines
                entry.Line.From     = mid
                entry.Line.To       = Vector2.new(sp.X, sp.Y)
                entry.Line.Color    = c
            else
                entry.Box.Visible  = false
                entry.Text.Visible = false
                entry.Line.Visible = false
                RemoveHL(entry)
            end
        end

        if Cfg.Guns then
            for gun in pairs(GunCache) do
                if not (gun.Parent and gun:IsDescendantOf(Workspace)) then
                    if GunESP[gun] then DestroyEntry(GunESP[gun]) GunESP[gun] = nil end
                    GunCache[gun] = nil
                    continue
                end
                if not GunESP[gun] then GunESP[gun] = NewEntry() end
                local entry = GunESP[gun]
                local gp, onScreen = Camera:WorldToViewportPoint(gun.Position)
                local c = Colors.DroppedGun
                if Cfg.Highlight then EnsureHL(entry, gun, c) end
                if onScreen then
                    entry.Box.Visible  = true
                    entry.Box.Color    = c
                    entry.Box.Position = Vector2.new(gp.X-12, gp.Y-12)
                    entry.Box.Size     = Vector2.new(24, 24)
                    entry.Text.Visible = Cfg.Labels
                    entry.Text.Text    = "[ GUN ]"
                    entry.Text.Color   = c
                    entry.Text.Position= Vector2.new(gp.X, gp.Y-30)
                    entry.Line.Visible = Cfg.Lines
                    entry.Line.From    = mid
                    entry.Line.To      = Vector2.new(gp.X, gp.Y)
                    entry.Line.Color   = c
                else
                    entry.Box.Visible  = false
                    entry.Text.Visible = false
                    entry.Line.Visible = false
                end
            end
        end
    end

