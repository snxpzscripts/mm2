-- ── Fly ───────────────────────────────────
local FlyEnabled   = false
local FlySpeed     = 50
local FlyDir       = { f=0, b=0, l=0, r=0 }
local FlyInputs    = {}

local function StopAnims()
    pcall(function()
        local char = GetChar()
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            for _, t in ipairs(hum:GetPlayingAnimationTracks()) do t:Stop(0) end
        end
        local animate = char:FindFirstChild("Animate")
        if animate then animate.Disabled = false end
    end)
end

local function StartFly(char)
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local hum   = char:FindFirstChildOfClass("Humanoid")
    if not (torso and hum) then return end

    for _, c in ipairs(torso:GetChildren()) do
        if c.Name == "MozqlFly" then c:Destroy() end
    end

    local bg = Instance.new("BodyGyro", torso)
    bg.Name = "MozqlFly"
    bg.P = 20000
    bg.maxTorque = Vector3.one * math.huge
    bg.CFrame = torso.CFrame

    local bv = Instance.new("BodyVelocity", torso)
    bv.Name = "MozqlFly"
    bv.velocity = Vector3.new(0, 0.1, 0)
    bv.maxForce = Vector3.one * math.huge

    while FlyEnabled do
        task.wait()
        pcall(function()
            if char.Parent and hum:GetState() ~= Enum.HumanoidStateType.Dead then
                hum.PlatformStand = true
                local dir = Vector3.new(FlyDir.l+FlyDir.r, 0, FlyDir.f+FlyDir.b)
                local world = Camera.CFrame:VectorToWorldSpace(dir).Unit
                bv.Velocity = dir.Magnitude > 0 and world * FlySpeed or Vector3.new(0, 0.1, 0)
                bg.CFrame = Camera.CFrame * CFrame.Angles(-math.rad(75)*(FlyDir.f+FlyDir.b), 0, math.rad(30)*(FlyDir.l+FlyDir.r))
            else
                FlyEnabled = false
            end
        end)
        if not FlyEnabled then break end
    end

    pcall(function()
        bg:Destroy()
        bv:Destroy()
        hum.PlatformStand = false
        StopAnims()
    end)
end

